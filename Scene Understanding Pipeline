# STAGE 5 – CAPTION EVALUATION
# ─────────────────────────────────────────────────────────────────────────────
class CaptionEvaluator:
    """Compute BLEU, ROUGE, METEOR between generated and reference captions."""

    def evaluate(self, generated: List[str], references: List[str]) -> Dict:
        results: Dict[str, Any] = {}
        try:
            from nltk.translate.bleu_score import corpus_bleu, SmoothingFunction
            import nltk
            nltk.download("punkt", quiet=True)
            nltk.download("wordnet", quiet=True)
            sf   = SmoothingFunction().method1
            refs = [[r.split()] for r in references]
            hyps = [g.split() for g in generated]
            results["bleu_1"] = corpus_bleu(refs, hyps, weights=(1,0,0,0), smoothing_function=sf)
            results["bleu_2"] = corpus_bleu(refs, hyps, weights=(.5,.5,0,0), smoothing_function=sf)
            results["bleu_4"] = corpus_bleu(refs, hyps, smoothing_function=sf)
        except Exception as exc:
            print(f"[WARN] BLEU failed: {exc}")

        try:
            from rouge_score import rouge_scorer
            scorer = rouge_scorer.RougeScorer(["rouge1","rouge2","rougeL"], use_stemmer=True)
            r1, r2, rl = [], [], []
            for g, r in zip(generated, references):
                s = scorer.score(r, g)
                r1.append(s["rouge1"].fmeasure)
                r2.append(s["rouge2"].fmeasure)
                rl.append(s["rougeL"].fmeasure)
            results["rouge_1"] = float(np.mean(r1))
            results["rouge_2"] = float(np.mean(r2))
            results["rouge_L"] = float(np.mean(rl))
        except Exception as exc:
            print(f"[WARN] ROUGE failed: {exc}")

        try:
            from nltk.translate.meteor_score import meteor_score as ms
            scores = [ms([r.split()], g.split()) for g, r in zip(generated, references)]
            results["meteor"] = float(np.mean(scores))
        except Exception as exc:
            print(f"[WARN] METEOR failed: {exc}")

        return results



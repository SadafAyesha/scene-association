def main():
    print("=" * 70)
    print("  Traffic Scene Understanding Pipeline")
    print("  YOLO-World  |  EKF  |  DeepSORT  |  VLM Captioning")
    print("=" * 70)

    vp = input(f"\nVideo path [{VIDEO_PATH}]: ").strip() or VIDEO_PATH
    if not os.path.exists(vp):
        print(f"[ERROR] File not found: {vp}")
        return

    raw_mf = input("Max frames to process (Enter = all): ").strip()
    mf = int(raw_mf) if raw_mf.isdigit() else None

    TrafficPipeline(video_path=vp, max_frames=mf).run()


if __name__ == "__main__":
    main()

# VISUALIZER
# ─────────────────────────────────────────────────────────────────────────────
class Visualizer:

    # ── Draw tracking overlay on frame ───────────────────────────────────────
    @staticmethod
    def draw_tracks(frame: np.ndarray,
                    tracks: List[Tuple],
                    ekf_data: Dict[int, Tuple[float, str]],
                    class_names: List[str]) -> np.ndarray:
        out = frame.copy()
        for t in tracks:
            x1,y1,x2,y2, tid, cid, conf = t
            spd, dirn = ekf_data.get(tid, (0.0, "N/A"))
            name  = class_names[cid] if cid < len(class_names) else "obj"
            color = (0, 255, 0)
            cv2.rectangle(out, (x1,y1),(x2,y2), color, 2)
            cv2.putText(out, f"ID:{tid} {name}",  (x1, y1-30), cv2.FONT_HERSHEY_SIMPLEX, 0.45, color, 2)
            cv2.putText(out, f"Spd:{spd:.1f}px/f",(x1, y1-15), cv2.FONT_HERSHEY_SIMPLEX, 0.40, (0,0,255), 1)
            cv2.putText(out, f"Dir:{dirn}",        (x1, y1),    cv2.FONT_HERSHEY_SIMPLEX, 0.40, (255,0,0), 1)
        return out

    # ── Draw relationship lines ───────────────────────────────────────────────
    @staticmethod
    def draw_spatial(frame: np.ndarray,
                     dets: List[Dict],
                     rels_df: pd.DataFrame) -> np.ndarray:
        out = frame.copy()
        for _, row in rels_df.iterrows():
            # Find bboxes
            o1 = next((d for d in dets if d["object_id"]==row["obj1_id"]), None)
            o2 = next((d for d in dets if d["object_id"]==row["obj2_id"]), None)
            if o1 and o2:
                c1 = tuple(map(int, o1["bbox_center"]))
                c2 = tuple(map(int, o2["bbox_center"]))
                cv2.line(out, c1, c2, (0,0,255), 1)
                mid = ((c1[0]+c2[0])//2, (c1[1]+c2[1])//2)
                cv2.putText(out, f"{row['euclidean_dist_px']:.0f}px",
                            mid, cv2.FONT_HERSHEY_SIMPLEX, 0.35, (0,165,255), 1)
        return out

    # ── Plot performance metrics ──────────────────────────────────────────────
    @staticmethod
    def plot_spatial_metrics(df: pd.DataFrame):
        cols = ["mean_iou","precision","recall","f1_score"]
        available = [c for c in cols if c in df.columns]
        if not available:
            return
        fig, axes = plt.subplots(1, len(available), figsize=(5*len(available), 4))
        if len(available) == 1:
            axes = [axes]
        for ax, col in zip(axes, available):
            ax.plot(df.get("frame_id", range(len(df))), df[col])
            ax.set_title(col.replace("_"," ").title())
            ax.set_xlabel("Frame")
            ax.set_ylabel("Score")
        plt.tight_layout()
        plt.savefig(f"{OUTPUT_DIR}/visualizations/spatial_metrics.png", dpi=150)
        plt.close()

    @staticmethod
    def plot_temporal_metrics(df: pd.DataFrame):
        if "avg_speed_px_per_frame" not in df.columns:
            return
        plt.figure(figsize=(10, 4))
        plt.plot(df.get("frame_id", range(len(df))), df["avg_speed_px_per_frame"])
        plt.title("Average Object Speed per Frame")
        plt.xlabel("Frame"); plt.ylabel("Speed (px/frame)")
        plt.tight_layout()
        plt.savefig(f"{OUTPUT_DIR}/visualizations/temporal_speed.png", dpi=150)
        plt.close()

    @staticmethod
    def plot_captioning_metrics(metrics: Dict):
        if not metrics:
            return
        plt.figure(figsize=(8, 4))
        names = list(metrics.keys())
        vals  = [metrics[k] for k in names]
        plt.bar(names, vals, color="steelblue")
        plt.ylim(0, 1)
        plt.title("Caption Evaluation Metrics")
        plt.ylabel("Score")
        plt.tight_layout()
        plt.savefig(f"{OUTPUT_DIR}/visualizations/captioning_metrics.png", dpi=150)
        plt.close()

    @staticmethod
    def plot_distance_heatmap(matrix: np.ndarray, labels: List[str], frame_id: int):
        if matrix.size == 0:
            return
        plt.figure(figsize=(max(4, len(labels)), max(3, len(labels))))
        sns.heatmap(matrix, annot=True, fmt=".0f", cmap="viridis",
                    xticklabels=labels, yticklabels=labels)
        plt.title(f"Distance Matrix – Frame {frame_id}")
        plt.tight_layout()
        plt.savefig(f"{OUTPUT_DIR}/visualizations/dist_matrix_f{frame_id}.png", dpi=120)
        plt.close()


# ─────────────────────────────────────────────────────────────────────────────
# MASTER PIPELINE
# ─────────────────────────────────────────────────────────────────────────────
class TrafficPipeline:
    """Orchestrates all five stages."""

    def __init__(self, video_path: str = VIDEO_PATH, max_frames: Optional[int] = None):
        self.video_path = video_path
        self.max_frames = max_frames
        self.detector   = YOLOWorldDetector(YOLO_MODEL_SIZE, CONFIDENCE_THRESHOLD)
        self.spatial    = SpatialAnalyzer()
        self.deepsort   = DeepSORTWrapper()
        self.ekf        = EKFTracker()
        self.captioner  = VLMCaptioner(VLM_BACKEND, VLM_MODEL_ID)
        self.evaluator  = CaptionEvaluator()
        self.viz        = Visualizer()

        # Accumulators
        self._spatial_metrics: List[Dict] = []
        self._rel_frames:      List[pd.DataFrame] = []
        self._temporal_rows:   List[Dict] = []
        self._caption_rows:    List[Dict] = []

    # ─────────────────────────────────────────────────────────────
    def run(self):
        global CLASS_NAMES
        make_dirs()
        CLASS_NAMES = load_class_names()
        print(f"[Config]  Classes: {CLASS_NAMES}")
        print(f"[Config]  Video  : {self.video_path}")

        # Load models
        if not self.detector.load():
            return
        ds_ok  = self.deepsort.load()
        vlm_ok = self.captioner.load()

        # Open video
        cap = cv2.VideoCapture(self.video_path)
        if not cap.isOpened():
            print(f"[ERROR] Cannot open {self.video_path}")
            return

        W   = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        H   = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        FPS = cap.get(cv2.CAP_PROP_FPS) or 25.0
        fourcc = cv2.VideoWriter.fourcc(*"mp4v")
        vw   = cv2.VideoWriter(f"{OUTPUT_DIR}/traffic_analysis_output.mp4", fourcc, FPS, (W, H))

        frame_id = 0
        print("\n[Pipeline] Processing frames …\n")

        while True:
            ret, frame = cap.read()
            if not ret:
                break
            if self.max_frames and frame_id >= self.max_frames:
                break

            if frame_id % 10 == 0:
                print(f"  Frame {frame_id:05d} …")

            # ── Stage 1: Detect ───────────────────────────────────────────────
            annotated, dets = self.detector.detect(frame)
            dets = filter_detections(dets)

            # ── Stage 2: Spatial ─────────────────────────────────────────────
            rels_df = self.spatial.compute_relationships(dets, frame_id)
            self._rel_frames.append(rels_df)
            s_metrics = self.spatial.evaluate(dets, frame_id)
            self._spatial_metrics.append(s_metrics)

            # Optional heatmap every 30 frames
            if frame_id % 30 == 0 and dets:
                mat    = self.spatial.distance_matrix(dets)
                labels = [f"{d['class_name']}_{d['object_id']}" for d in dets]
                self.viz.plot_distance_heatmap(mat, labels, frame_id)

            # ── Stage 3: Tracking (DeepSORT + EKF) ───────────────────────────
            tracks  = self.deepsort.update(dets, frame)
            ekf_map: Dict[int, Tuple[float, str]] = {}
            temporal_row: Dict = {"frame_id": frame_id, "tracked_count": len(tracks),
                                   "speeds": [], "directions": defaultdict(int)}

            for t in tracks:
                x1,y1,x2,y2, tid, cid, conf = t
                spd, dirn = self.ekf.update(tid, [x1,y1,x2,y2])
                ekf_map[tid] = (spd, dirn)
                temporal_row["speeds"].append(spd)
                temporal_row["directions"][dirn] += 1

            avg_spd = float(np.mean(temporal_row["speeds"])) if temporal_row["speeds"] else 0.0
            self._temporal_rows.append({
                "frame_id":             frame_id,
                "tracked_count":        len(tracks),
                "avg_speed_px_per_frame": avg_spd,
                "dominant_direction":   max(temporal_row["directions"],
                                            key=temporal_row["directions"].get,
                                            default="N/A"),
            })

            # ── Stage 4: Caption ─────────────────────────────────────────────
            cls_counts = {c: sum(1 for d in dets if d["class_name"]==c) for c in CLASS_NAMES}
            spatial_ctx  = ", ".join(f"{v} {k}(s)" for k,v in cls_counts.items() if v>0)
            temporal_ctx = f"avg speed {avg_spd:.1f} px/frame"
            caption = self.captioner.caption(frame, spatial_ctx, temporal_ctx)
            scene   = self.captioner.scene_label(caption)
            self._caption_rows.append({
                "frame_id":   frame_id,
                "caption":    caption,
                "scene_label": scene,
            })

            # ── Compose output frame ──────────────────────────────────────────
            vis = self.viz.draw_spatial(annotated, dets, rels_df)
            vis = self.viz.draw_tracks(vis, tracks, ekf_map, CLASS_NAMES)

            # Overlay caption (word-wrap to 70 chars)
            words, line, y_off = caption.split(), "", H - 60
            for w in words:
                if len(line)+len(w) > 70:
                    cv2.putText(vis, line.strip(), (10, y_off),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.45, (255,255,255), 1)
                    y_off += 18; line = ""
                line += w + " "
            if line:
                cv2.putText(vis, line.strip(), (10, y_off),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.45, (255,255,255), 1)

            cv2.putText(vis, f"Scene: {scene}", (10, 30),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0,255,255), 2)

            vw.write(vis)
            frame_id += 1

        cap.release()
        vw.release()
        print(f"\n[Pipeline] {frame_id} frames processed.")

        # ── Save all outputs ─────────────────────────────────────────────────
        self._save_outputs(frame_id, vlm_ok)

    # ─────────────────────────────────────────────────────────────
    def _save_outputs(self, total_frames: int, vlm_loaded: bool):
        csv_dir = f"{OUTPUT_DIR}/csv"

        # Spatial
        if self._rel_frames:
            pd.concat(self._rel_frames, ignore_index=True).to_csv(
                f"{csv_dir}/spatial_relationships.csv", index=False)

        if self._spatial_metrics:
            df_s = pd.DataFrame(self._spatial_metrics)
            df_s.to_csv(f"{csv_dir}/performance_metrics.csv", index=False)
            spatial_cols = ["frame_id","mean_iou","precision","recall","f1_score",
                            "matched_detections","total_ground_truth","total_detections",
                            "false_positives","false_negatives"]
            df_s[[c for c in spatial_cols if c in df_s.columns]].to_csv(
                f"{csv_dir}/spatial_accuracy_metrics.csv", index=False)
            self.viz.plot_spatial_metrics(df_s)

        # Temporal
        if self._temporal_rows:
            df_t = pd.DataFrame(self._temporal_rows)
            df_t.to_csv(f"{csv_dir}/temporal_accuracy_metrics.csv", index=False)
            self.viz.plot_temporal_metrics(df_t)

            # MOTA / HOTA placeholders (require ground-truth tracklets)
            pd.DataFrame({
                "metric": ["MOTA","HOTA","Note"],
                "value":  [0.0, 0.0, "Requires GT tracklets – use py-motmetrics/trackeval"]
            }).to_csv(f"{csv_dir}/mota_hota.csv", index=False)

        # Captions
        if self._caption_rows:
            df_c = pd.DataFrame(self._caption_rows)
            df_c.to_csv(f"{csv_dir}/frame_captions.csv", index=False)

            # Evaluate if GT available
            cap_metrics: Dict = {}
            if CAPTION_GT_CSV and os.path.exists(CAPTION_GT_CSV):
                df_gt = pd.read_csv(CAPTION_GT_CSV)
                merged = df_c.merge(df_gt, on="frame_id", suffixes=("_gen","_ref"))
                if len(merged) > 0:
                    cap_metrics = self.evaluator.evaluate(
                        merged["caption_gen"].tolist(), merged["caption_ref"].tolist())
            else:
                print("[Stage-5] No GT captions found – skipping BLEU/ROUGE/METEOR.")
                cap_metrics = {"note": "No ground-truth captions provided"}

            pd.DataFrame([cap_metrics]).to_csv(f"{csv_dir}/captioning_metrics.csv", index=False)
            if isinstance(cap_metrics, dict) and any(isinstance(v,float) for v in cap_metrics.values()):
                self.viz.plot_captioning_metrics(
                    {k:v for k,v in cap_metrics.items() if isinstance(v,float)})

        # Summary JSON
        summary = {
            "total_frames":  total_frames,
            "video_path":    self.video_path,
            "classes":       CLASS_NAMES,
            "vlm_backend":   VLM_BACKEND,
            "vlm_loaded":    vlm_loaded,
            "timestamp":     datetime.now().isoformat(),
            "outputs": {
                "annotated_video":   f"{OUTPUT_DIR}/traffic_analysis_output.mp4",
                "spatial_accuracy":  f"{csv_dir}/spatial_accuracy_metrics.csv",
                "performance":       f"{csv_dir}/performance_metrics.csv",
                "temporal_accuracy": f"{csv_dir}/temporal_accuracy_metrics.csv",
                "mota_hota":         f"{csv_dir}/mota_hota.csv",
                "captions":          f"{csv_dir}/frame_captions.csv",
                "captioning_metrics":f"{csv_dir}/captioning_metrics.csv",
            }
        }
        with open(f"{OUTPUT_DIR}/analysis_summary.json", "w") as f:
            json.dump(summary, f, indent=2)

        print("\n✅  All outputs saved:")
        for k, v in summary["outputs"].items():
            print(f"   {k:25s} → {v}")
        print(f"   {'summary':25s} → {OUTPUT_DIR}/analysis_summary.json")



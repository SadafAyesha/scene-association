# ─────────────────────────────────────────────────────────────────────────────
# STAGE 1 – YOLO-WORLD DETECTION
# ─────────────────────────────────────────────────────────────────────────────
class YOLOWorldDetector:
    """Zero-shot object detector using YOLO-World (roboflow/inference backend)."""

    def __init__(self, model_size: str = "l", conf_thresh: float = 0.30):
        self.model_size  = model_size
        self.conf_thresh = conf_thresh
        self.model       = None
        self.classes: List[str] = []

    def load(self) -> bool:
        print(f"[Stage-1] Loading YOLO-World/{self.model_size} …")
        try:
            from inference.models.yolo_world.yolo_world import YOLOWorld
            self.model = YOLOWorld(model_id=f"yolo_world/{self.model_size}")
            self.classes = CLASSES_TO_DETECT
            self.model.set_classes(self.classes)
            print(f"           Classes set: {self.classes}")
            return True
        except Exception as exc:
            print(f"[ERROR] YOLO-World load failed: {exc}")
            return False

    def detect(self, frame: np.ndarray) -> Tuple[np.ndarray, List[Dict]]:
        """Return (annotated_frame, detections_list)."""
        from supervision.detection.core import Detections
        from supervision.annotators.core import BoxAnnotator, LabelAnnotator

        results    = self.model.infer(frame, confidence=self.conf_thresh)
        detections = Detections.from_inference(results).with_nms(threshold=0.10)

        annotated = frame.copy()
        annotated = BoxAnnotator(thickness=2).annotate(annotated, detections)
        annotated = LabelAnnotator(text_scale=0.5, text_thickness=1).annotate(annotated, detections)

        det_list: List[Dict] = []
        if hasattr(detections, "xyxy") and len(detections.xyxy) > 0:
            for i in range(len(detections.xyxy)):
                x1, y1, x2, y2 = detections.xyxy[i]
                cls_id = int(detections.class_id[i]) if hasattr(detections, "class_id") else 0
                conf   = float(detections.confidence[i]) if hasattr(detections, "confidence") else 0.0
                cx, cy = (x1 + x2) / 2, (y1 + y2) / 2
                det_list.append({
                    "object_id":   i,
                    "class_id":    cls_id,
                    "class_name":  self.classes[cls_id] if cls_id < len(self.classes) else "unknown",
                    "confidence":  conf,
                    "bbox":        [float(x1), float(y1), float(x2), float(y2)],
                    "bbox_center": [cx, cy],
                    "bbox_size":   [x2 - x1, y2 - y1],
                    "area":        (x2 - x1) * (y2 - y1),
                })
        return annotated, det_list


def filter_detections(dets: List[Dict]) -> List[Dict]:
    """Keep only detections whose class_name is in CLASS_NAMES."""
    name_set = set(CLASS_NAMES)
    out = []
    for d in dets:
        if d["class_name"] in name_set:
            d["class_id"] = CLASS_NAMES.index(d["class_name"])
            out.append(d)
    return out


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 2 – SPATIAL ANALYSIS
# ─────────────────────────────────────────────────────────────────────────────
class SpatialAnalyzer:
    """Compute pairwise spatial relationships and IoU-based performance metrics."""

    # ── IoU helpers ──────────────────────────────────────────────────────────
    @staticmethod
    def iou(b1: List[float], b2: List[float]) -> float:
        ix1, iy1 = max(b1[0], b2[0]), max(b1[1], b2[1])
        ix2, iy2 = min(b1[2], b2[2]), min(b1[3], b2[3])
        if ix2 <= ix1 or iy2 <= iy1:
            return 0.0
        inter = (ix2 - ix1) * (iy2 - iy1)
        union = (b1[2]-b1[0])*(b1[3]-b1[1]) + (b2[2]-b2[0])*(b2[3]-b2[1]) - inter
        return inter / union if union > 0 else 0.0

    # ── Pairwise relationships ────────────────────────────────────────────────
    def compute_relationships(self, dets: List[Dict], frame_id: int) -> pd.DataFrame:
        rows = []
        for i, o1 in enumerate(dets):
            for j, o2 in enumerate(dets):
                if i == j:
                    continue
                c1, c2 = o1["bbox_center"], o2["bbox_center"]
                dist   = float(np.linalg.norm(np.array(c1) - np.array(c2)))
                angle  = float(np.degrees(np.arctan2(c2[1]-c1[1], c2[0]-c1[0])))
                rel    = ("right_of" if -45 <= angle < 45 else
                          "above"    if 45  <= angle < 135 else
                          "left_of"  if abs(angle) >= 135 else "below")
                rows.append({
                    "frame_id":          frame_id,
                    "obj1_id":           o1["object_id"],
                    "obj1_class":        o1["class_name"],
                    "obj2_id":           o2["object_id"],
                    "obj2_class":        o2["class_name"],
                    "euclidean_dist_px": dist,
                    "relative_x":        c2[0] - c1[0],
                    "relative_y":        c2[1] - c1[1],
                    "relationship":      rel,
                    "timestamp":         datetime.now().isoformat(),
                })
        return pd.DataFrame(rows)

    # ── Distance matrix ───────────────────────────────────────────────────────
    def distance_matrix(self, dets: List[Dict]) -> np.ndarray:
        n = len(dets)
        M = np.zeros((n, n))
        for i, o1 in enumerate(dets):
            for j, o2 in enumerate(dets):
                if i != j:
                    M[i, j] = float(np.linalg.norm(
                        np.array(o1["bbox_center"]) - np.array(o2["bbox_center"])))
        return M

    # ── GT loading ────────────────────────────────────────────────────────────
    def load_gt(self, frame_id: int) -> Optional[List[Dict]]:
        img_files = sorted(glob.glob(os.path.join(GROUND_TRUTH_IMG_DIR, "*.jpg")))
        if frame_id >= len(img_files):
            return None
        base  = os.path.splitext(os.path.basename(img_files[frame_id]))[0]
        lpath = os.path.join(GROUND_TRUTH_LABEL_DIR, base + ".txt")
        ipath = img_files[frame_id]
        if not os.path.exists(lpath):
            return None
        img   = cv2.imread(ipath)
        ih, iw = img.shape[:2] if img is not None else (1080, 1920)
        gt = []
        with open(lpath) as f:
            for line in f:
                parts = line.strip().split()
                if len(parts) < 5:
                    continue
                cid = int(parts[0])
                xc, yc, bw, bh = map(float, parts[1:5])
                gt.append({
                    "class_id": cid,
                    "class_name": CLASS_NAMES[cid] if cid < len(CLASS_NAMES) else "unknown",
                    "bbox": [
                        (xc - bw/2)*iw, (yc - bh/2)*ih,
                        (xc + bw/2)*iw, (yc + bh/2)*ih,
                    ],
                })
        return gt

    # ── Spatial accuracy metrics ──────────────────────────────────────────────
    def evaluate(self, dets: List[Dict], frame_id: int,
                 iou_thresh: float = IOU_THRESHOLD) -> Dict:
        gt = self.load_gt(frame_id)
        if gt is None:
            # No GT → return confidence-based internal metrics
            if not dets:
                return {"frame_id": frame_id, "detection_count": 0}
            confs = [d["confidence"] for d in dets]
            return {
                "frame_id": frame_id,
                "detection_count": len(dets),
                "avg_confidence":  float(np.mean(confs)),
            }

        matched_dets, matched_gts = set(), set()
        iou_scores = []
        for i, det in enumerate(dets):
            best_iou, best_j = 0.0, -1
            for j, g in enumerate(gt):
                if j in matched_gts:
                    continue
                v = self.iou(det["bbox"], g["bbox"])
                if v > best_iou:
                    best_iou, best_j = v, j
            if best_iou >= iou_thresh and best_j >= 0:
                matched_dets.add(i)
                matched_gts.add(best_j)
                iou_scores.append(best_iou)

        tp  = len(matched_dets)
        fp  = len(dets) - tp
        fn  = len(gt)  - tp
        prec   = tp / (tp + fp) if (tp + fp) > 0 else 0.0
        rec    = tp / (tp + fn) if (tp + fn) > 0 else 0.0
        f1     = 2*prec*rec / (prec+rec) if (prec+rec) > 0 else 0.0
        miou   = float(np.mean(iou_scores)) if iou_scores else 0.0

        return {
            "frame_id":           frame_id,
            "mean_iou":           miou,
            "precision":          prec,
            "recall":             rec,
            "f1_score":           f1,
            "matched_detections": tp,
            "total_ground_truth": len(gt),
            "total_detections":   len(dets),
            "false_positives":    fp,
            "false_negatives":    fn,
        }


# ─────────────────────────────────────────────────────────────────────────────
# STAGE 3a – EXTENDED KALMAN FILTER TRACKER
# ─────────────────────────────────────────────────────────────────────────────
class EKFTracker:
    """
    Per-object EKF with state vector [cx, cy, vx, vy].
    Call update(object_id, bbox) each frame; query speed() and direction().
    """

    def __init__(self, dt: float = 1.0, proc_noise: float = 1.0, meas_noise: float = 10.0):
        self.dt   = dt
        self.Q    = np.eye(4) * proc_noise
        self.R    = np.eye(2) * meas_noise
        # State: {id: (x [4,1], P [4,4])}
        self.states: Dict[int, Tuple[np.ndarray, np.ndarray]] = {}

    def _F(self) -> np.ndarray:
        F = np.eye(4)
        F[0, 2] = self.dt
        F[1, 3] = self.dt
        return F

    def _H(self) -> np.ndarray:
        H = np.zeros((2, 4))
        H[0, 0] = 1.0
        H[1, 1] = 1.0
        return H

    def update(self, obj_id: int, bbox: List[float]) -> Tuple[float, str]:
        """Return (speed_px_per_frame, direction_string)."""
        cx = (bbox[0] + bbox[2]) / 2
        cy = (bbox[1] + bbox[3]) / 2
        z  = np.array([[cx], [cy]])
        F, H = self._F(), self._H()

        if obj_id not in self.states:
            x = np.array([[cx], [cy], [0.0], [0.0]])
            P = np.eye(4) * 100.0
        else:
            x, P = self.states[obj_id]

        # Predict
        x = F @ x
        P = F @ P @ F.T + self.Q

        # Update
        S  = H @ P @ H.T + self.R
        K  = P @ H.T @ np.linalg.inv(S)
        x  = x + K @ (z - H @ x)
        P  = (np.eye(4) - K @ H) @ P

        self.states[obj_id] = (x, P)

        vx, vy = float(x[2, 0]), float(x[3, 0])
        speed  = float(np.sqrt(vx**2 + vy**2))
        angle  = float(np.degrees(np.arctan2(-vy, vx)))
        if   -45 <= angle < 45:   direction = "East"
        elif  45 <= angle < 135:  direction = "North"
        elif abs(angle) >= 135:   direction = "West"
        else:                     direction = "South"

        return speed, direction



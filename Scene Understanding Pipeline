# STAGE 4 – VLM CAPTIONING
# ─────────────────────────────────────────────────────────────────────────────
class VLMCaptioner:
    """Scene captioner using BLIP-2 or LLaVA."""

    def __init__(self, backend: str = "blip2", model_id: str = "Salesforce/blip2-opt-2.7b"):
        self.backend  = backend.lower()
        self.model_id = model_id
        self.model    = None
        self.processor= None
        self.device   = "cpu"

    def load(self) -> bool:
        print(f"[Stage-4] Loading VLM ({self.backend}) …")
        try:
            import torch
            self.device = "cuda" if torch.cuda.is_available() else "cpu"

            if self.backend == "blip2":
                from transformers import Blip2Processor, Blip2ForConditionalGeneration
                self.processor = Blip2Processor.from_pretrained(self.model_id)
                self.model     = Blip2ForConditionalGeneration.from_pretrained(
                    self.model_id, torch_dtype=torch.float16 if self.device == "cuda" else torch.float32
                ).to(self.device)

            elif self.backend == "llava":
                from transformers import LlavaForConditionalGeneration, AutoProcessor
                self.processor = AutoProcessor.from_pretrained(self.model_id)
                self.model     = LlavaForConditionalGeneration.from_pretrained(
                    self.model_id, torch_dtype=torch.float16 if self.device == "cuda" else torch.float32
                ).to(self.device)

            else:
                raise ValueError(f"Unknown VLM backend: {self.backend}")

            print(f"           VLM ready on {self.device}.")
            return True
        except Exception as exc:
            print(f"[WARN] VLM load failed ({exc}). Captions will be template-based.")
            return False

    def caption(self, frame: np.ndarray, spatial_ctx: str = "", temporal_ctx: str = "") -> str:
        """Generate a scene-level caption for the frame."""
        if self.model is None:
            return self._template_caption(spatial_ctx, temporal_ctx)

        from PIL import Image
        import torch
        rgb  = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        pil  = Image.fromarray(rgb)
        prompt = (
            "Describe the traffic scene. Focus on: vehicle types, congestion level, "
            "any accidents or suspicious activity, and general traffic flow. "
            f"Context: {spatial_ctx}. Motion: {temporal_ctx}."
        )

        with torch.no_grad():
            if self.backend == "blip2":
                inputs = self.processor(images=pil, text=prompt, return_tensors="pt").to(self.device)
                ids    = self.model.generate(**inputs, max_new_tokens=80)
                return self.processor.decode(ids[0], skip_special_tokens=True)

            elif self.backend == "llava":
                conv   = f"USER: <image>\n{prompt}\nASSISTANT:"
                inputs = self.processor(text=conv, images=pil, return_tensors="pt").to(self.device)
                ids    = self.model.generate(**inputs, max_new_tokens=80)
                full   = self.processor.decode(ids[0], skip_special_tokens=True)
                return full.split("ASSISTANT:")[-1].strip()

    @staticmethod
    def _template_caption(spatial_ctx: str, temporal_ctx: str) -> str:
        return f"Traffic scene with vehicles detected. {spatial_ctx} {temporal_ctx}".strip()

    @staticmethod
    def scene_label(caption: str) -> str:
        c = caption.lower()
        if any(k in c for k in ["accident", "collision", "crash"]):
            return "accident"
        if any(k in c for k in ["congestion", "heavy traffic", "jam", "slow"]):
            return "congestion"
        if any(k in c for k in ["suspicious", "wrong way", "illegal"]):
            return "suspicious"
        return "normal_traffic"



# STAGE 3b – DEEPSORT TRACKER
# ─────────────────────────────────────────────────────────────────────────────
class DeepSORTWrapper:
    """Thin wrapper around deep_sort_pytorch."""

    def __init__(self):
        self.tracker = None

    def load(self) -> bool:
        print("[Stage-3] Loading DeepSORT …")
        try:
            from deep_sort_pytorch.utils.parser import get_config
            from deep_sort_pytorch.deep_sort import DeepSort
            cfg = get_config()
            cfg.merge_from_file(DEEPSORT_CFG)
            ckpt = DEEPSORT_CKPT or cfg.DEEPSORT.REID_CKPT
            self.tracker = DeepSort(
                ckpt,
                max_dist=cfg.DEEPSORT.MAX_DIST,
                min_confidence=cfg.DEEPSORT.MIN_CONFIDENCE,
                nms_max_overlap=cfg.DEEPSORT.NMS_MAX_OVERLAP,
                max_iou_distance=cfg.DEEPSORT.MAX_IOU_DISTANCE,
                max_age=cfg.DEEPSORT.MAX_AGE,
                n_init=cfg.DEEPSORT.N_INIT,
                nn_budget=cfg.DEEPSORT.NN_BUDGET,
                use_cuda=True,
            )
            print("           DeepSORT loaded.")
            return True
        except Exception as exc:
            print(f"[WARN] DeepSORT unavailable ({exc}). Falling back to centroid tracker.")
            return False

    def update(self, dets: List[Dict], frame: np.ndarray
               ) -> List[Tuple[int, int, int, int, int, int, float]]:
        """Return list of (x1,y1,x2,y2, track_id, class_id, conf)."""
        if not dets:
            if self.tracker:
                self.tracker.increment_ages()
            return []

        if self.tracker is None:
            # Simple centroid fallback — assign object_id as track_id
            return [(int(d["bbox"][0]), int(d["bbox"][1]),
                     int(d["bbox"][2]), int(d["bbox"][3]),
                     d["object_id"], d["class_id"], d["confidence"]) for d in dets]

        xywhs = np.array([[d["bbox"][0], d["bbox"][1],
                           d["bbox"][2]-d["bbox"][0], d["bbox"][3]-d["bbox"][1]] for d in dets])
        confs = np.array([d["confidence"] for d in dets])
        clss  = np.array([d["class_id"]   for d in dets])
        raw   = self.tracker.update(xywhs, confs, clss, frame)
        out   = []
        for t in raw:
            x1, y1, x2, y2, tid, cid, cf = t
            out.append((int(x1), int(y1), int(x2), int(y2), int(tid), int(cid), float(cf)))
        return out


